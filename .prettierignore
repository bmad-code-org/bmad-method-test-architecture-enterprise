# Test fixtures with intentionally broken/malformed files
test/fixtures/**

# Evaluate-authored evaluation folders. corpus-index.json digests the exact
# bytes of the probes, mutations and corpus files beside it, and
# tea-evaluate check refuses a stale index, so reformatting them would break
# the digest the evaluation commits.
test/evaluations/**

# Stored GitHub Actions workflow files the ci eval replay corpus scores.
# Several are deliberately malformed YAML that a real run could produce, and
# reformatting them would fail the check they exist to be scored against.
test/replay/ci/**

# Immutable Story 1.2 live outputs stay byte-identical to the runner artifacts.
test/results/atdd-story-1.2/post-fix-*.json

# Generated from test/schema/eval-result.js by tools/validate-eval-schemas.js,
# which compares it byte for byte to catch drift. Reformatting it here would
# make that comparison fail on formatting rather than on content.
test/schema/eval-result.schema.json

# Live suite-result records are written and schema-validated by the eval harness.
# Reformatting them would alter immutable measurement evidence after generation.
test/results/live-eval-remediation/**/*.json

# Complete eval:all records preserve the runner's unedited JSON serialization.
test/results/eval-all/*.json
test/results/eval-all/history/*.json

# The BMad memlog: an append-only process log written by
# _bmad/scripts/memlog.py, never edited by hand, so its layout is the
# script's to own (.markdownlint-cli2.yaml excludes it for the same reason).
**/.memlog.md

# Contributor Covenant (external standard)
CODE_OF_CONDUCT.md

# The BMAD runtime install directory: generated per project, never committed.
# _bmad-output/ is a sibling, not a match of this pattern: it holds this
# repository's own tracked planning artifacts and is gated like any other
# markdown.
_bmad/

# Story 1.29's approved matrix is frozen and retains its approved spacing.
_bmad-output/implementation-artifacts/evaluate/story-1.29.md

# Story 1.54's approved matrix is frozen and retains its approved spacing.
_bmad-output/implementation-artifacts/evaluate/story-1.54.md

# Immutable raw generation and runner measurements.
test/results/automate-codex-2026-10-09/before/
test/results/automate-codex-2026-10-09/after/
test/results/automate-codex-2026-10-09/red/
test/results/automate-codex-2026-10-09/final/
