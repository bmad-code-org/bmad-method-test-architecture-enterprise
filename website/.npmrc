# npm reads a project .npmrc from the local prefix and does not inherit it across
# directories, so `npm --prefix website install` reads this file and never the
# repository root's. Without it the website graph resolves with no floor, and a
# registry a contributor's own user or global config points elsewhere would
# apply here while the root install stayed pinned to npmjs.org.
# min-release-age stays equal to the root's; test/test-supply-chain.js holds both.
registry=https://registry.npmjs.org
min-release-age=7
