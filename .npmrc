registry=https://registry.npmjs.org

# ===== SUPPLY CHAIN =====

# Refuse to resolve a version published less than 7 days ago. This filters
# resolution only: a young entry already sitting in a committed lockfile installs
# under npm ci regardless, which is why `npm run test:lockfile-age` re-checks both
# committed lockfiles against the registry and fails closed.
min-release-age=7

# TEA follows eval-quality's latest published release. Its lockfile records the
# resolved version, and the corpus gate checks that installed tree. Exclude this
# direct engine dependency from the seven-day floor so upgrades can be adopted
# when published. The lockfile-age gate keeps the same exclusion in sync.
min-release-age-exclude=eval-quality
