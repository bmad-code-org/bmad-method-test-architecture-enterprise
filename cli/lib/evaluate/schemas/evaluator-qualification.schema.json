{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tea:evaluate:schema:evaluator-qualification",
  "title": "runs/<invocationId>/evaluator-qualification.json",
  "description": "What tea-evaluate run wrote when it qualified a sealed-brief agent evaluator before its first trial (Story 1.34): per arm and probe, each attempt's outcome copied from the evidence artifact eval-quality score wrote, and the agreement with the state the arm expects. An attempt eval-quality reads as Invalid has no artifact, so it is kept with the engine's exit code and its invalid lines. The tea-evaluate runtime owns this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempts", "minimumAgreement", "arms"],
  "properties": {
    "attempts": { "type": "integer", "minimum": 2 },
    "minimumAgreement": { "type": "number", "minimum": 0, "maximum": 1 },
    "arms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conditionArm", "agreement", "probes"],
        "properties": {
          "conditionArm": { "type": "string", "pattern": "^(?:clean|mutated:.+)$" },
          "agreement": {
            "description": "The lowest agreement among the arm's probes.",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "probes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["probeId", "expectedOutcome", "agreement", "attempts"],
              "properties": {
                "probeId": { "type": "string", "pattern": "^P-[0-9]{3,}$" },
                "expectedOutcome": { "enum": ["passed-clean-control", "caught"] },
                "agreement": {
                  "description": "The fraction of attempts whose reduced state equals expectedOutcome.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "attempts": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["attempt", "exitCode", "evidence", "outcome", "invalid", "agrees"],
                    "allOf": [
                      {
                        "if": { "properties": { "exitCode": { "const": 3 } } },
                        "then": {
                          "properties": { "evidence": { "type": "null" }, "outcome": { "type": "null" }, "agrees": { "const": false } }
                        },
                        "else": {
                          "properties": { "evidence": { "type": "string" }, "outcome": { "type": "string" }, "invalid": { "maxItems": 0 } }
                        }
                      }
                    ],
                    "properties": {
                      "attempt": { "type": "integer", "minimum": 1 },
                      "exitCode": {
                        "description": "eval-quality score's exit code for the attempt's record: 0 or 2 with an evidence artifact, 3 when it reads the attempt as Invalid.",
                        "enum": [0, 2, 3]
                      },
                      "evidence": {
                        "description": "The evidence artifact eval-quality wrote, relative to the run directory; null for an Invalid attempt, which emits none.",
                        "type": ["string", "null"],
                        "minLength": 1
                      },
                      "outcome": {
                        "description": "The state in the evidence artifact's reducedProbeOutcomes trialVotes, copied unchanged; null when there is no artifact.",
                        "type": ["string", "null"],
                        "minLength": 1
                      },
                      "invalid": {
                        "description": "The engine's invalid stderr lines, empty unless the attempt is Invalid.",
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "agrees": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
