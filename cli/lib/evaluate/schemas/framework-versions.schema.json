{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tea:evaluate:schema:framework-versions",
  "title": "runs/<invocationId>/framework-versions.json",
  "description": "What tea-evaluate run observed of a command evaluator's declared frameworks before its first trial (Stories 1.44, 1.71 and 1.73): each declared version and optional install-state source, the effective probe timeout, the observed package, version, matching install source and digest for a declared source (null when its probe failed), and diagnostics for faults. The tea-evaluate runtime owns this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "frameworks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "declaredVersion", "observed"],
        "properties": {
          "package": { "type": "string", "minLength": 1 },
          "declaredVersion": { "type": "string", "minLength": 1 },
          "installState": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source"],
            "properties": { "source": { "enum": ["tree", "lockfile"] } }
          },
          "effectiveProbeTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
          "observed": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["package", "version"],
                "properties": {
                  "package": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1 },
                  "installSource": { "enum": ["tree", "lockfile"] },
                  "installDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                }
              }
            ]
          },
          "fault": { "type": "string" },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "required": ["installState"], "properties": { "observed": { "type": "object" } } },
            "then": {
              "properties": {
                "observed": {
                  "required": ["installSource", "installDigest"]
                }
              }
            }
          },
          {
            "if": { "not": { "required": ["installState"] }, "properties": { "observed": { "type": "object" } } },
            "then": {
              "properties": {
                "observed": {
                  "not": { "anyOf": [{ "required": ["installDigest"] }, { "required": ["installSource"] }] }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "installState": { "properties": { "source": { "const": "tree" } }, "required": ["source"] } },
              "required": ["installState"]
            },
            "then": { "properties": { "observed": { "properties": { "installSource": { "const": "tree" } } } } }
          },
          {
            "if": {
              "properties": { "installState": { "properties": { "source": { "const": "lockfile" } }, "required": ["source"] } },
              "required": ["installState"]
            },
            "then": { "properties": { "observed": { "properties": { "installSource": { "const": "lockfile" } } } } }
          }
        ]
      }
    },
    "problems": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
