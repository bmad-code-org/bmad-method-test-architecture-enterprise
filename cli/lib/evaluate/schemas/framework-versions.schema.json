{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tea:evaluate:schema:framework-versions",
  "title": "runs/<invocationId>/framework-versions.json",
  "description": "What tea-evaluate run observed of a command evaluator's declared frameworks before its first trial (Stories 1.44 and 1.71): per framework the declared version, the effective probe timeout, the observed package and version (null when its probe failed), a failed probe's fault with the first characters of its output, and the problems that stopped the run. The tea-evaluate runtime owns this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "frameworks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "declaredVersion", "observed"],
        "properties": {
          "package": { "type": "string", "minLength": 1 },
          "declaredVersion": { "type": "string", "minLength": 1 },
          "effectiveProbeTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
          "observed": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["package", "version"],
                "properties": { "package": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
              }
            ]
          },
          "fault": { "type": "string" },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" }
        }
      }
    },
    "problems": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
