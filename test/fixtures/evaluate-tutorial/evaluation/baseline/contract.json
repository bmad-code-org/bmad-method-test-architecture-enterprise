  "behaviors": [
    {
      "id": "B-001",
      "description": "The refund-check skill approves a refund whose amount is exactly the limit.",
      "severity": "critical",
      "observableSuccessCriterion": "Asked about a refund of 100 against the limit of 100, the runner prints one JSON object whose status is \"answered\" and whose decision is \"approved\".",
      "requirementLinks": [
        {
          "scheme": "tutorial-requirements",
          "id": "limit-is-inclusive"
        }
      ],
      "riskLinks": [
        {
          "scheme": "tutorial-requirements",
          "id": "exclusive-limit-wording"
        }
      ],
      "oracles": [
        "O-001"
      ]
    },
    {
      "id": "B-002",
      "description": "The refund-check skill refuses a request that gives no amount and limit.",
      "severity": "material",
      "observableSuccessCriterion": "Asked a malformed request, the runner prints one JSON object whose status is \"refused\".",
      "requirementLinks": [
        {
          "scheme": "tutorial-requirements",
          "id": "malformed-request-refused"
        }
      ],
      "riskLinks": [
        {
          "scheme": "tutorial-requirements",
          "id": "malformed-request-answered"
        }
      ],
      "oracles": [
        "O-002"
      ]
    }
  ],
  "oracles": [
    {
      "id": "O-001",
      "polarity": "expects-hold",
      "commentary": "The skill answers, and the decision for a refund at the limit is approved. The oracle reads the status claim beside the decision and accepts neither alone.",
      "direction": {
        "polarity": "expects-hold",
        "relation": "all",
        "scope": "The status claim and the decision of the JSON object the review-refund step prints on stdout.",
        "negativeDomain": "A reply whose status is not \"answered\" or whose decision for a refund at the limit is anything but \"approved\".",
        "evidenceTargets": [
          "/interactions/review-refund/stdout/status",
          "/interactions/review-refund/stdout/decision"
        ]
      },
      "check": {
        "op": "all",
        "operands": [
          {
            "op": "equality",
            "operands": [
              {
                "pointer": "/interactions/review-refund/stdout/status"
              },
              {
                "literal": "answered"
              }
            ]
          },
          {
            "op": "equality",
            "operands": [
              {
                "pointer": "/interactions/review-refund/stdout/decision"
              },
              {
                "literal": "approved"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "O-002",
      "polarity": "expects-hold",
      "commentary": "A request with no amount and limit gets no decision: the skill refuses it.",
      "direction": {
        "polarity": "expects-hold",
        "relation": "equality",
        "scope": "The status claim of the JSON object the reject-malformed step prints on stdout.",
        "negativeDomain": "A reply to a malformed request whose status is anything but \"refused\".",
        "evidenceTargets": [
          "/interactions/reject-malformed/stdout/status"
        ]
      },
      "check": {
        "op": "equality",
        "operands": [
          {
            "pointer": "/interactions/reject-malformed/stdout/status"
          },
          {
            "literal": "refused"
          }
        ]
      }
    }
  ],
