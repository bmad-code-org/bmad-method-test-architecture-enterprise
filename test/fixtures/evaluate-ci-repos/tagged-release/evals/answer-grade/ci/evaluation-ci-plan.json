{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "check",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "check",
        "--evaluation",
        "evals/answer-grade"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/check/stdout"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic, needs no secret and calls no model. .github/workflows/ci.yml runs on pull_request and CONTRIBUTING.md names its `test` job as the required check, so this runs on every pull request (CAP-11)."
      }
    },
    {
      "id": "compile",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/compile/eval-contract.json"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic, needs no secret. Runs on every pull request with the rest of the deterministic set (CAP-11); .github/workflows/ci.yml is the pull_request workflow."
      }
    },
    {
      "id": "seal",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/seal/sealed-evaluator-brief.json"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic, needs no secret. Runs on every pull request with the rest of the deterministic set (CAP-11); .github/workflows/ci.yml is the pull_request workflow."
      }
    },
    {
      "id": "api-conformance",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/api-conformance/stdout"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "The registry names an HTTP target (answer-grade, POST /grade), so the port conformance check applies. Deterministic, so it stays on pr (CAP-11)."
      }
    },
    {
      "id": "gameability",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/replay/scores"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Probes P-009 and P-015 take the gameability route, so the arm applies. Deterministic, so it stays on pr (CAP-11)."
      }
    },
    {
      "id": "oracle-agreement",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "baseline/scores"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic, needs no secret. CAP-11 requires oracle-versus-scorer agreement on every pull request."
      }
    },
    {
      "id": "replay",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/replay/preflight-verdict.json",
        "runs/<invocationId>/replay/scores"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic, needs no secret. Replays the accepted baseline on every pull request (CAP-11). Needs baseline/ accepted first."
      }
    },
    {
      "id": "preflight-live",
      "tier": "merge",
      "trigger": [
        "merge"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "preflight",
        "--evaluation",
        "evals/answer-grade"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/preflight-live/stdout"
      ],
      "placement": {
        "tier": "merge",
        "defaultTier": "merge",
        "reason": "The registry names no environmentKeys and the target is a local HTTP server (app/server/grade.mjs), so it needs no secret and AD-10 defaults to merge. ci.yml runs on pull_request only, but a merge to main is the post-merge event and CONTRIBUTING.md states no cap on its run time; squash merges and no queue are no reason to move it."
      }
    },
    {
      "id": "twin-run",
      "tier": "release",
      "trigger": [
        "release"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "release"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/twin-run/stdout"
      ],
      "placement": {
        "tier": "release",
        "defaultTier": "release",
        "reason": "No workflow has a schedule trigger and docs/RELEASING.md says \"There is no scheduled job\", so no scheduled entry exists. The tag push that starts .github/workflows/release.yml is the only home for the live set, and the contract declares a critical behavior (B-001). The publish job shares release.yml with the evaluation jobs, so it waits for this tier through gates; the adopter has not declined the gate."
      },
      "gates": [
        "publish"
      ]
    },
    {
      "id": "held-out",
      "tier": "release",
      "trigger": [
        "release"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "release"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/held-out/stdout"
      ],
      "placement": {
        "tier": "release",
        "defaultTier": "release",
        "reason": "No schedule trigger exists (docs/RELEASING.md: \"no scheduled job\"), so the held-out partition runs at the tag push in .github/workflows/release.yml, where B-001 is critical and a defect stays in the registry about six weeks (docs/RELEASING.md)."
      }
    },
    {
      "id": "strength-comparison",
      "tier": "release",
      "trigger": [
        "release"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "release"
      ],
      "enforcement": "warn",
      "evidence": [
        "runs/<invocationId>/checks/strength-comparison/stdout"
      ],
      "placement": {
        "tier": "release",
        "defaultTier": "release",
        "reason": "No schedule trigger exists (docs/RELEASING.md: \"no scheduled job\"), so strength comparison runs with the rest of the live set at the tag push in .github/workflows/release.yml. A strength regression is a warning (AD-10)."
      }
    }
  ]
}
