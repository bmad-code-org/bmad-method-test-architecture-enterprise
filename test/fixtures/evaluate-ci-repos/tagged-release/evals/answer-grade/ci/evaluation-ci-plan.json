    {
      "id": "preflight-live",
      "tier": "merge",
      "trigger": [
        "merge"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "preflight",
        "--evaluation",
        "evals/answer-grade"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/preflight-live/stdout"
      ],
      "placement": {
        "tier": "merge",
        "defaultTier": "merge",
        "reason": "The target needs no secret: evaluation.json registry environmentKeys is empty and app/server/grade.mjs is the deterministic stand-in for the vendor model, so AD-10 defaults the live preflight to merge. The adopter states no run-time or cost cap that moves it. ci.yml has no push trigger today, so bmad-testarch-ci adds a push to main trigger for this tier."
      }
    },
    {
      "id": "twin-run",
      "tier": "release",
      "trigger": [
        "release"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "release"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/twin-run/stdout"
      ],
      "placement": {
        "tier": "release",
        "defaultTier": "release",
        "reason": "No workflow has a schedule trigger and docs/RELEASING.md says there is no scheduled job, so no scheduled entry exists. The tag push that starts .github/workflows/release.yml is the release gate (docs/RELEASING.md). B-001 is critical, releases ship about every six weeks and consumers pin versions, so a defect that ships lives for weeks."
      }
    },
    {
      "id": "held-out",
      "tier": "release",
      "trigger": [
        "release"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
