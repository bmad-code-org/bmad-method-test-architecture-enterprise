      ],
      "placement": {
        "tier": "release",
        "defaultTier": "release",
        "reason": "No schedule trigger exists in the repository, so the held-out partition (P-011, P-012, P-013) runs at the tag in .github/workflows/release.yml, the only release gate (docs/RELEASING.md). B-001 is critical and a shipped defect stays until the next tag."
      }
    },
