      "id": "check",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "check",
        "--evaluation",
        "evals/answer-grade"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/check/stdout"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic and needs no secret. .github/workflows/ci.yml runs on pull_request, so every pull request gets it (CAP-11)."
      }
    },
