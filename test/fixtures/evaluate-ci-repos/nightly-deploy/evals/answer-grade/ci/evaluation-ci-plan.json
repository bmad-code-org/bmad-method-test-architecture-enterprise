{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "check",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "check",
        "--evaluation",
        "evals/answer-grade"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/check/stdout"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": ".github/workflows/ci.yml runs on pull_request and CONTRIBUTING.md requires the test check; the check needs no secret and calls no model, so it stays at its pr default."
      }
    },
