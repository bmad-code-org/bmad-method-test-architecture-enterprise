      "placement": {
        "tier": "merge",
        "defaultTier": "merge",
        "reason": "The target needs no secret (the registry's server.environmentKeys is empty; app/server/grade.mjs applies app/rules/policy.json), and .github/workflows/ci.yml has a merge_group trigger and CONTRIBUTING.md says merges go through the merge queue, so the merge tier has an event."
      }
