    {
      "id": "preflight-live",
      "tier": "merge",
      "trigger": [
        "merge"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "preflight",
        "--evaluation",
        "evals/answer-grade"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/preflight-live/stdout"
      ],
      "placement": {
        "tier": "merge",
        "defaultTier": "merge",
        "reason": "The target needs no secret: the registry lists no environmentKeys, the stand-in app/server/grade.mjs runs on loopback, and requirements.md says there are no secrets or vendor calls. .github/workflows/ci.yml lists merge_group and CONTRIBUTING.md says the merge queue re-runs the test check on the queued commit, so a post-merge run exists. A preflight against a local stub is far inside that job's 15-minute timeout, so it keeps its merge default."
      }
    },
    {
      "id": "twin-run",
      "tier": "scheduled",
      "trigger": [
        "schedule",
        "manual-dispatch"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "scheduled"
      ],
      "enforcement": "warn",
      "evidence": [
        "runs/<invocationId>/checks/twin-run/stdout"
      ],
      "placement": {
        "tier": "scheduled",
        "defaultTier": "scheduled",
        "reason": ".github/workflows/nightly.yml runs on schedule (02:17 UTC) and workflow_dispatch against main. The contract declares a critical behavior (B-001) and docs/DEPLOYING.md says a grading defect reaches learners within 24 hours. A live run costs no model calls (the target is the deterministic stand-in), so a nightly run is cheap. Warn follows AD-10 for scheduled."
      }
    },
    {
      "id": "held-out",
      "tier": "scheduled",
      "trigger": [
        "schedule",
        "manual-dispatch"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "scheduled"
      ],
      "enforcement": "warn",
      "evidence": [
        "runs/<invocationId>/checks/held-out/stdout"
      ],
      "placement": {
        "tier": "scheduled",
        "defaultTier": "scheduled",
        "reason": "Held-out partition (P-011 to P-013) runs nightly in .github/workflows/nightly.yml; schedule and workflow_dispatch triggers exist, the target needs no secret, and a missed defect ships within 24 hours (docs/DEPLOYING.md). Warn follows AD-10 for scheduled."
      }
    },
    {
      "id": "strength-comparison",
      "tier": "scheduled",
      "trigger": [
        "schedule",
        "manual-dispatch"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "scheduled"
      ],
      "enforcement": "warn",
