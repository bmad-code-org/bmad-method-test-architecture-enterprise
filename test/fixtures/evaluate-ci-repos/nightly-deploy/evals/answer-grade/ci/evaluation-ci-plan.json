        "runs/<invocationId>/checks/strength-comparison/stdout"
      ],
      "placement": {
        "tier": "scheduled",
        "defaultTier": "scheduled",
        "reason": "Compares the nightly run with baseline/ in .github/workflows/nightly.yml; a strength regression is a warning on scheduled per AD-10."
      }
    },
    {
      "id": "twin-run",
      "tier": "release",
      "trigger": [
        "release"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "release"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/twin-run/stdout"
      ],
      "placement": {
        "tier": "release",
        "defaultTier": "release",
        "reason": ".github/workflows/deploy.yml starts on schedule (03:47 UTC) and workflow_dispatch and is the workflow that ships main to production (docs/DEPLOYING.md), so its trigger is the release event. B-001 is critical and the grade decides whether a learner passes a course."
      }
    },
