    {
      "id": "twin-run",
      "tier": "scheduled",
      "trigger": [
        "schedule",
        "manual-dispatch"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "scheduled"
      ],
      "enforcement": "warn",
      "evidence": [
        "runs/<invocationId>/checks/twin-run/stdout"
      ],
      "placement": {
        "tier": "scheduled",
        "defaultTier": "scheduled",
        "reason": ".github/workflows/nightly.yml runs on schedule and workflow_dispatch at 02:17 UTC, and docs/DEPLOYING.md says a grading defect reaches learners within 24 hours, so a daily run is the longest a defect may live. The target needs no model call; a live set costs 3 trials over 13 probes, about 39 requests to the local stand-in."
      }
    },
