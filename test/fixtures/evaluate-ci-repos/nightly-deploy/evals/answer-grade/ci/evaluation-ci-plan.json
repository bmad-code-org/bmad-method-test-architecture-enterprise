      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Probe P-009 takes the gameability route (corpus/gameability/P-009.json), and the arm replays deterministically with no secret, so it stays on pr (CAP-11)."
      }
    },
    {
      "id": "oracle-agreement",
