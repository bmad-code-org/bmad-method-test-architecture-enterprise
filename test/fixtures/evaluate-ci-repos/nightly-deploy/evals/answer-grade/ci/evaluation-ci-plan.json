{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "check",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "check",
        "--evaluation",
        "evals/answer-grade"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/check/stdout"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic; needs no secret and calls no model, so it runs on every pull request. .github/workflows/ci.yml runs on pull_request and CONTRIBUTING.md says fork pull requests run without any secret."
      }
    },
    {
      "id": "compile",
