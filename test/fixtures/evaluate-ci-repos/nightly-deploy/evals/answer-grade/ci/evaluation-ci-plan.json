      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic brief seal; no secret, no model call, so it stays on pr (CAP-11)."
      }
    },
    {
      "id": "api-conformance",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
