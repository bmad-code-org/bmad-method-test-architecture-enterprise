        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/compile/eval-contract.json"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic contract compile; no secret, no model call, so it stays on pr (CAP-11)."
      }
    },
    {
