      "placement": {
        "tier": "merge",
        "defaultTier": "merge",
        "reason": "The target is app/server/grade.mjs launched locally with environmentKeys [] and needs no secret. .github/workflows/ci.yml lists merge_group and CONTRIBUTING.md says the merge queue re-runs the test check on the queued commit, so a post-merge run exists. Nothing in the repository caps its run time, so the default holds."
      }
