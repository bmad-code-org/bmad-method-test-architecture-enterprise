{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "check",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "check",
        "--evaluation",
        "evals/answer-grade"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/check/stdout"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic and secret-free. .github/workflows/ci.yml runs on pull_request and CONTRIBUTING.md names the test check as required, so the pr tier is the default home; no inspection moved it."
      }
    },
    {
      "id": "compile",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/compile/eval-contract.json"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic and secret-free; it stays on pr with the rest of the deterministic set (CAP-11). ci.yml runs on pull_request with no secret."
      }
    },
    {
      "id": "seal",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/seal/sealed-evaluator-brief.json"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic and secret-free; it stays on pr with the rest of the deterministic set (CAP-11). ci.yml runs on pull_request with no secret."
      }
    },
    {
      "id": "api-conformance",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/api-conformance/stdout"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "The evaluation declares an api interface (evaluation.json interface api, adapter/http-probe-port.conformance.mjs), so the check applies; it needs no secret and stays on pr."
      }
    },
    {
      "id": "gameability",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/replay/scores"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Probes P-009 and P-015 take the gameability route and the arm calls no model; CAP-11 keeps it on pr, and ci.yml gives pull requests no secret."
      }
    },
    {
      "id": "oracle-agreement",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "baseline/scores"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Deterministic oracle against scorer check with no secret; CAP-11 keeps it on pr."
      }
    },
    {
      "id": "replay",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "pr"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/replay/preflight-verdict.json",
        "runs/<invocationId>/replay/scores"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "Replays the recorded run with no secret and no model call; CAP-11 keeps it on pr. It reads baseline/, which the maintainer accepts from the latest scored run."
      }
    },
    {
      "id": "preflight-live",
      "tier": "merge",
      "trigger": [
        "merge"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "preflight",
        "--evaluation",
        "evals/answer-grade"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/preflight-live/stdout"
      ],
      "placement": {
        "tier": "merge",
        "defaultTier": "merge",
        "reason": "The registry names no environmentKeys and the target is the loopback stand-in app/server/grade.mjs, so it needs no secret and defaults to merge. .github/workflows/ci.yml lists merge_group and CONTRIBUTING.md says the merge queue re-runs the test check on the queued commit, so a post-merge run exists; the preflight runs locally against that stand-in and fits ci.yml's 15 minute timeout."
      }
    },
    {
      "id": "twin-run",
      "tier": "scheduled",
      "trigger": [
        "schedule",
        "manual-dispatch"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "scheduled"
      ],
      "enforcement": "warn",
      "evidence": [
        "runs/<invocationId>/checks/twin-run/stdout"
      ],
      "placement": {
        "tier": "scheduled",
        "defaultTier": "scheduled",
        "reason": "Live set at its default. .github/workflows/nightly.yml runs on schedule and workflow_dispatch, and docs/DEPLOYING.md says a grading defect reaches learners within 24 hours of the nightly deploy, so a nightly run bounds a defect's life. The evaluation itself needs no key and makes no model call. It reports only (warn), since deploy.yml does not wait for nightly.yml."
      }
    },
    {
      "id": "held-out",
      "tier": "scheduled",
      "trigger": [
        "schedule",
        "manual-dispatch"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "scheduled"
      ],
      "enforcement": "warn",
      "evidence": [
        "runs/<invocationId>/checks/held-out/stdout"
      ],
      "placement": {
        "tier": "scheduled",
        "defaultTier": "scheduled",
        "reason": "Held-out partition at its default. nightly.yml has a schedule trigger, and the evaluation makes no model call, so a nightly run costs nothing beyond runner minutes."
      }
    },
    {
      "id": "strength-comparison",
      "tier": "scheduled",
      "trigger": [
        "schedule",
        "manual-dispatch"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "scheduled"
      ],
      "enforcement": "warn",
      "evidence": [
        "runs/<invocationId>/checks/strength-comparison/stdout"
      ],
      "placement": {
        "tier": "scheduled",
        "defaultTier": "scheduled",
        "reason": "Compares against baseline/ on the nightly schedule of .github/workflows/nightly.yml; no cost beyond runner minutes, the evaluator is deterministic."
      }
    },
    {
      "id": "twin-run",
      "tier": "release",
      "trigger": [
        "release",
        "manual-dispatch"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "release"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/twin-run/stdout"
      ],
      "placement": {
        "tier": "release",
        "defaultTier": "release",
        "reason": "The release event is the trigger of .github/workflows/deploy.yml, a nightly cron at 03:47 UTC plus workflow_dispatch (docs/DEPLOYING.md), hence release and manual-dispatch. Contract B-001 is critical and the grade decides whether a learner passes a course, so this tier blocks. The production job of deploy.yml shares the file the CI skill edits, so it waits for this tier through gates. deploy.yml is independent of nightly.yml (docs/DEPLOYING.md), which is why the scheduled run cannot serve as the gate."
      },
      "gates": [
        "production"
      ]
    },
    {
      "id": "held-out",
      "tier": "release",
      "trigger": [
        "release",
        "manual-dispatch"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "release"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/held-out/stdout"
      ],
      "placement": {
        "tier": "release",
        "defaultTier": "release",
        "reason": "Held-out partition at its default on the deploy.yml trigger (nightly cron and workflow_dispatch); B-001 is critical and a missed defect ships within 24 hours (docs/DEPLOYING.md)."
      }
    },
    {
      "id": "strength-comparison",
      "tier": "release",
      "trigger": [
        "release",
        "manual-dispatch"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "ci",
        "--evaluation",
        "evals/answer-grade",
        "--tier",
        "release"
      ],
      "enforcement": "warn",
      "evidence": [
        "runs/<invocationId>/checks/strength-comparison/stdout"
      ],
      "placement": {
        "tier": "release",
        "defaultTier": "release",
        "reason": "Default placement on the deploy.yml trigger. It warns only, since AD-10 gives this check no block on release."
      }
    }
  ]
}
