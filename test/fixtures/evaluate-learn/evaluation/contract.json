        }
      ],
      "oracles": [
        "O-002"
      ]
    }
  ],
  "oracles": [
    {
      "id": "O-001",
      "polarity": "expects-hold",
      "commentary": "The CLI exits cleanly and prints the exact complete pantry summary with a final newline.",
      "direction": {
        "polarity": "expects-hold",
        "relation": "all",
        "scope": "Exit code and whole stdout of the summary step.",
        "negativeDomain": "A failed process or any omitted, added, reordered or changed output byte, including the newline.",
        "evidenceTargets": [
          "/interactions/summarize/exit-code",
          "/interactions/summarize/stdout"
        ]
      },
      "check": {
        "op": "all",
        "operands": [
          {
            "op": "equality",
            "operands": [
              {
                "pointer": "/interactions/summarize/exit-code"
              },
              {
                "literal": 0
              }
            ]
          },
          {
            "op": "equality",
            "operands": [
              {
                "pointer": "/interactions/summarize/stdout"
              },
              {
                "literal": "Summary for List pantry: apples, pears\n"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "O-002",
      "polarity": "expects-hold",
      "commentary": "Malformed request text is rejected with exit code 2, the exact stderr diagnostic, and no summary on stdout.",
      "direction": {
        "polarity": "expects-hold",
        "relation": "all",
        "scope": "Exit code, whole stderr, and whole stdout of the malformed request step.",
        "negativeDomain": "A malformed request receives a summary, a different error, or a different exit code.",
        "evidenceTargets": [
          "/interactions/reject-malformed/exit-code",
          "/interactions/reject-malformed/stderr",
          "/interactions/reject-malformed/stdout"
        ]
      },
      "check": {
        "op": "all",
        "operands": [
          {
            "op": "equality",
            "operands": [
              {
                "pointer": "/interactions/reject-malformed/exit-code"
              },
              {
                "literal": 2
              }
            ]
          },
          {
            "op": "equality",
            "operands": [
              {
                "pointer": "/interactions/reject-malformed/stderr"
              },
              {
                "literal": "error: invalid list request\n"
              }
            ]
          },
          {
            "op": "equality",
            "operands": [
              {
                "pointer": "/interactions/reject-malformed/stdout"
              },
              {
