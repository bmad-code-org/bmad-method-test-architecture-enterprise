        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "check",
        "--evaluation",
        "evals/notes"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/check/stdout"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "AD-10 default: a deterministic check that needs no secret runs on every pull request (CAP-11)."
