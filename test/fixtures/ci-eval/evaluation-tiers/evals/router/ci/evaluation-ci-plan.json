      "id": "check",
      "tier": "pr",
      "trigger": [
        "pull-request"
      ],
      "kind": "evaluate",
      "command": [
        "tea-evaluate",
        "check",
        "--evaluation",
        "evals/router"
      ],
      "enforcement": "block",
      "evidence": [
        "runs/<invocationId>/checks/check/stdout"
      ],
      "placement": {
        "tier": "pr",
        "defaultTier": "pr",
        "reason": "AD-10 default: a deterministic check that needs no secret runs on every pull request (CAP-11)."
      }
    },
