{
  "$ref": "#/definitions/EvalRun",
  "definitions": {
    "EvalResult": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.4.0"
        },
        "kind": {
          "type": "string",
          "const": "suite-result"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "type": "string",
          "enum": [
            "live",
            "validate-only",
            "preflight-only"
          ]
        },
        "repository": {
          "type": "object",
          "properties": {
            "commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "dirty": {
              "type": "boolean"
            }
          },
          "required": [
            "commit",
            "dirty"
          ],
          "additionalProperties": false
        },
        "suite": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "evalType": {
              "type": "string",
              "enum": [
                "fragment-selection",
                "behavioral",
                "infrastructure"
              ]
            },
            "skills": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/EvalResult/properties/suite/properties/id"
              }
            },
            "contracts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "$ref": "#/definitions/EvalResult/properties/suite/properties/id"
                  },
                  "version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "path",
                  "version"
                ],
                "additionalProperties": false
              }
            },
            "ciTier": {
              "type": "string",
              "enum": [
                "deterministic",
                "smoke",
                "full-matrix"
              ]
            },
            "runnerCapabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "read-only",
                  "scoped-artifact-writes",
                  "command-execution"
                ]
              },
              "minItems": 1
            },
            "fixtureDigest": {
              "type": "string",
              "pattern": "^sha256:[\\da-f]{64}$"
            },
            "promptDigest": {
              "anyOf": [
                {
                  "$ref": "#/definitions/EvalResult/properties/suite/properties/fixtureDigest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "caseIds": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/EvalResult/properties/suite/properties/id"
              }
            },
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/EvalResult/properties/suite/properties/id"
                  },
                  "promptDigest": {
                    "anyOf": [
                      {
                        "$ref": "#/definitions/EvalResult/properties/suite/properties/fixtureDigest"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "promptDigest"
                ],
                "additionalProperties": false
              }
            },
            "thresholds": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "declaredRepetitions": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "id",
            "evalType",
            "skills",
            "contracts",
            "ciTier",
            "runnerCapabilities",
            "fixtureDigest",
            "promptDigest",
            "caseIds",
            "cases",
            "thresholds",
            "declaredRepetitions"
          ],
          "additionalProperties": false
        },
        "runners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "$ref": "#/definitions/EvalResult/properties/suite/properties/id"
              },
              "executable": {
                "$ref": "#/definitions/EvalResult/properties/suite/properties/id"
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "agentArgs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "envPassNames": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "promptTransport": {
                    "type": "string",
                    "enum": [
                      "stdin",
                      "argv"
                    ]
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "$ref": "#/definitions/EvalResult/properties/suite/properties/id"
                        },
                        "version": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "args": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "name",
                        "version",
                        "args"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "agentArgs",
                  "envPassNames",
                  "timeoutMs",
                  "promptTransport"
                ],
                "additionalProperties": false
              },
              "repetitions": {
                "type": "object",
                "properties": {
                  "expected": {
                    "$ref": "#/definitions/EvalResult/properties/suite/properties/declaredRepetitions"
                  },
                  "completed": {
                    "$ref": "#/definitions/EvalResult/properties/suite/properties/declaredRepetitions"
                  }
                },
                "required": [
                  "expected",
                  "completed"
                ],
                "additionalProperties": false
              },
              "measurements": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "durationMs": {
                "$ref": "#/definitions/EvalResult/properties/suite/properties/declaredRepetitions"
              },
              "usage": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "inputTokens": {
                        "anyOf": [
                          {
                            "$ref": "#/definitions/EvalResult/properties/suite/properties/declaredRepetitions"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "outputTokens": {
                        "anyOf": [
                          {
                            "$ref": "#/definitions/EvalResult/properties/suite/properties/declaredRepetitions"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "totalTokens": {
                        "anyOf": [
                          {
                            "$ref": "#/definitions/EvalResult/properties/suite/properties/declaredRepetitions"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "costUsd": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "inputTokens",
                      "outputTokens",
                      "totalTokens",
                      "costUsd"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "failureClass": {
                "type": "string",
                "enum": [
                  "none",
                  "quality",
                  "environment-incomplete-repetitions",
                  "environment-parser",
                  "environment-missing-artifact",
                  "environment-timeout",
                  "environment-transport",
                  "environment-authentication",
                  "environment-configuration",
                  "environment-harness",
                  "unexpected-error"
                ]
              },
              "failures": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "caseId": {
                      "$ref": "#/definitions/EvalResult/properties/suite/properties/id"
                    },
                    "repetition": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "completionState": {
                      "type": "string",
                      "enum": [
                        "completed",
                        "failed"
                      ]
                    },
                    "signature": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "metricContributions": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      },
                      "propertyNames": {
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "failureClass": {
                      "type": "string",
                      "enum": [
                        "none",
                        "quality",
                        "environment-incomplete-repetitions",
                        "environment-parser",
                        "environment-missing-artifact",
                        "environment-timeout",
                        "environment-transport",
                        "environment-authentication",
                        "environment-configuration",
                        "environment-harness",
                        "unexpected-error"
                      ]
                    },
                    "rootCause": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "tea-workflow-defect",
                            "model-instability",
                            "harness-defect",
                            "corpus-defect",
                            "oracle-defect"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "reason": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "output-signature",
                              "artifact",
                              "summary"
                            ]
                          },
                          "value": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2048
                          }
                        },
                        "required": [
                          "kind",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 32
                    }
                  },
                  "required": [
                    "caseId",
                    "repetition",
                    "completionState",
                    "signature",
                    "metricContributions",
                    "failureClass",
                    "rootCause",
                    "reason",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "agent",
              "executable",
              "version",
              "model",
              "parameters",
              "repetitions",
              "measurements",
              "durationMs",
              "usage",
              "failureClass",
              "failures",
              "diagnostics"
            ],
            "additionalProperties": false
          }
        },
        "suiteDiagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "failureClass": {
                "type": "string",
                "enum": [
                  "none",
                  "quality",
                  "environment-incomplete-repetitions",
                  "environment-parser",
                  "environment-missing-artifact",
                  "environment-timeout",
                  "environment-transport",
                  "environment-authentication",
                  "environment-configuration",
                  "environment-harness",
                  "unexpected-error"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/EvalResult/properties/runners/items/properties/diagnostics/items/properties/evidence/items"
                },
                "maxItems": 32
              }
            },
            "required": [
              "failureClass",
              "reason",
              "evidence"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "durationMs": {
          "$ref": "#/definitions/EvalResult/properties/suite/properties/declaredRepetitions"
        },
        "failureClass": {
          "type": "string",
          "enum": [
            "none",
            "quality",
            "environment-incomplete-repetitions",
            "environment-parser",
            "environment-missing-artifact",
            "environment-timeout",
            "environment-transport",
            "environment-authentication",
            "environment-configuration",
            "environment-harness",
            "unexpected-error"
          ]
        },
        "exitCode": {
          "type": "number",
          "enum": [
            0,
            1,
            2
          ]
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "generatedAt",
        "mode",
        "repository",
        "suite",
        "runners",
        "durationMs",
        "failureClass",
        "exitCode"
      ],
      "additionalProperties": false
    },
    "EvalRun": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.4.0"
        },
        "kind": {
          "type": "string",
          "const": "run-summary"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "repository": {
          "$ref": "#/definitions/EvalResult/properties/repository"
        },
        "evalQualityVersion": {
          "$ref": "#/definitions/EvalResult/properties/suite/properties/id"
        },
        "suites": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvalResult"
          }
        },
        "unaccountedSkills": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvalResult/properties/suite/properties/id"
          }
        },
        "durationMs": {
          "$ref": "#/definitions/EvalResult/properties/suite/properties/declaredRepetitions"
        },
        "failureClass": {
          "type": "string",
          "enum": [
            "none",
            "quality",
            "environment-incomplete-repetitions",
            "environment-parser",
            "environment-missing-artifact",
            "environment-timeout",
            "environment-transport",
            "environment-authentication",
            "environment-configuration",
            "environment-harness",
            "unexpected-error"
          ]
        },
        "exitCode": {
          "type": "number",
          "enum": [
            0,
            1,
            2
          ]
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "generatedAt",
        "repository",
        "evalQualityVersion",
        "suites",
        "unaccountedSkills",
        "durationMs",
        "failureClass",
        "exitCode"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
