      "observations": [
        {
          "criterion_id": "security-authentication",
          "supports": "OAuth 2.1 authorization-code flow with PKCE. Access tokens are signed ES256 and issued with a\n900-second (15-minute) lifetime; refresh tokens rotate on every use and the previous token is\nrevoked. Verified by `ledger/test/auth/token-lifetime.spec.ts`, which asserts the issued `exp`\nclaim, and by a manual replay of an expired token against every statement route."
        },
        {
          "criterion_id": "security-authorization",
          "supports": "Tenant-scoped RBAC is enforced in `ledger/src/http/tenant-guard.ts`, which runs ahead of every\nroute in the statements router. The authorization suite exercises all five statement routes with a\ntoken issued for a different tenant; each returns 403 and writes an audit record. Cross-tenant read\nattempts: 5 of 5 refused."
        },
        {
          "criterion_id": "security-compliance",
          "supports": "Confirmed with the compliance team on 2026-08-26: the ledger stores no cardholder data and no\npersonal health data, so PCI-DSS and HIPAA do not apply to this service. No other external regime\ncovers it. This section exists so a reader does not have to infer the scope from silence."
        },
        {
          "criterion_id": "security-data-protection",
          "supports": "At rest: the statements table and its backups use AES-256 volume encryption; keys rotate every 90\n  days through the platform key service."
        },
        {
          "criterion_id": "security-data-protection",
          "supports": "In transit: the ledger's ingress terminates TLS 1.3 only. TLS 1.2 and below were disabled on\n  2026-06-14 and the scan below confirms no downgrade path."
        }
      ]
    }
